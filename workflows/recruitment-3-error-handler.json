    {
      "parameters": {
        "jsCode": "// Aggregate error log items for daily digest\nconst logs = $input.all();\nconst currentEpochMinute = Math.floor(Date.now() / 60000);\nconst MINUTES_IN_24H = 1440;\n\nconst recentLogs = logs.filter(item => {\n  const epoch = Number(item.json['Epoch Minute'] || 0);\n  return (currentEpochMinute - epoch) <= MINUTES_IN_24H;\n});\n\nconst digestItems = recentLogs.filter(item => item.json.Alerted === 'digest only' || item.json.Alerted === 'throttled');\nconst hasReport = digestItems.length > 0;\n\nlet reportText = `Daily Error Digest - ${new Date().toLocaleDateString()}\\n\\n`;\nif (hasReport) {\n  reportText += `Total errors logged in last 24h: ${recentLogs.length}\\n`;\n  reportText += `Items in digest: ${digestItems.length}\\n\\nSummary:\\n`;\n  digestItems.forEach((err, idx) => {\n    reportText += `${idx + 1}. [${err.json.Severity || 'WARNING'}] ${err.json.Workflow} -> ${err.json.Node}: ${err.json.Message}\\n   Fix: ${err.json['Suggested Fix']}\\n`;\n  });\n} else {\n  reportText += \"No warnings or throttled errors reported in the last 24 hours.\";\n}\n\nreturn [{\n  json: {\n    hasReport,\n    reportText,\n    count: digestItems.length\n  }\n}];"
      },
